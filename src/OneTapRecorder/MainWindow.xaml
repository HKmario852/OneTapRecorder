<Window x:Class="OneTapRecorder.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource UI000}" Width="510" Height="780" MinWidth="490" MinHeight="700"
 WindowStartupLocation="CenterScreen" Background="#191D24" Foreground="#F5F6F8"
 FontFamily="Microsoft JhengHei UI" FontSize="14" ResizeMode="CanMinimize">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#AAB3C2"/>
  <Style x:Key="ModeChoice" TargetType="RadioButton">
   <Setter Property="Foreground" Value="#AAB3C2"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="ModeBorder" Background="#222832" BorderBrush="#343C49" BorderThickness="1" CornerRadius="8" Padding="12,11"><ContentPresenter HorizontalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="ModeBorder" Property="Background" Value="#443033"/><Setter TargetName="ModeBorder" Property="BorderBrush" Value="#FF625B"/><Setter Property="Foreground" Value="White"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ModeBorder" Property="Opacity" Value="0.5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ModeBorder" Property="BorderBrush" Value="White"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="#F5F6F8"/><Setter Property="Background" Value="#292F3A"/>
   <Setter Property="Padding" Value="10,9"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#424D60"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#F5F6F8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#2D3542" BorderBrush="#465164" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" Foreground="#C5CEDC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,3"/></Border></ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" Foreground="#F5F6F8" Margin="10,9,30,9" IsHitTestVisible="False" VerticalAlignment="Center"/>
     <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
      <Border Background="#292F3A" BorderBrush="#465164" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#DBE1EB"/><Setter Property="Background" Value="#292F3A"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,10"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Opacity" Value="0.85"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bg" Property="Opacity" Value="0.45"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="White"/><Setter TargetName="Bg" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Switch" TargetType="CheckBox">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Track" Width="46" Height="26" CornerRadius="13" Background="#535B68"><Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="4"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#FF625B"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="White"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="28,24,28,22">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <StackPanel Orientation="Horizontal"><TextBlock Text="◉" FontSize="23" Foreground="#FF625B" Margin="0,0,10,0"/><TextBlock Text="{DynamicResource UI000}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
   <Border HorizontalAlignment="Right" Margin="0,0,54,0" Background="#252D33" CornerRadius="12" Padding="10,5"><TextBlock x:Name="Badge" Text="{DynamicResource UI008}" FontSize="11" Foreground="#96DDC0"/></Border>
  </Grid>
  <Button x:Name="LanguageButton" Content="EN" Click="LanguageClick" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11" Padding="10,7" AutomationProperties.Name="Switch language / 切換語言"/>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,32,0,0">
   <TextBlock x:Name="Heading" Text="{DynamicResource UI007}" FontSize="29" FontWeight="Bold" HorizontalAlignment="Center"/>
   <TextBlock x:Name="Subtitle" Text="{DynamicResource UI009}" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,9,0,0"/>
   <TextBlock x:Name="TimerText" Text="00:00:00" FontFamily="Consolas" FontSize="30" Foreground="#DAE0E9" HorizontalAlignment="Center" Margin="0,19,0,20"/>
   <StackPanel x:Name="SettingsPanel">
    <UniformGrid Columns="2" Margin="0,0,0,12">
     <RadioButton x:Name="VideoMode" GroupName="RecordingMode" Style="{StaticResource ModeChoice}" Content="{DynamicResource UI005}" IsChecked="True" Checked="ModeChanged" Margin="0,0,5,0"/>
     <RadioButton x:Name="AudioMode" GroupName="RecordingMode" Style="{StaticResource ModeChoice}" Content="{DynamicResource UI006}" Checked="ModeChanged" Margin="5,0,0,0"/>
    </UniformGrid>
    <Border x:Name="MonitorPanel" Background="#222832" BorderBrush="#343C49" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{DynamicResource UI004}" VerticalAlignment="Center"/>
      <ComboBox x:Name="MonitorBox" Grid.Column="1" FontSize="13" Padding="8" AutomationProperties.Name="{DynamicResource UI093}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
     </Grid>
    </Border>
    <Border Background="#222832" BorderBrush="#343C49" BorderThickness="1" CornerRadius="12" Padding="17,14">
     <StackPanel>
      <Grid><StackPanel><TextBlock Text="{DynamicResource UI011}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource UI015}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="SystemAudio" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource UI094}"/></Grid>
      <Border Background="#343C49" Height="1" Margin="0,13"/>
      <Grid><StackPanel><TextBlock Text="{DynamicResource UI016}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource UI017}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel><CheckBox x:Name="Microphone" Style="{StaticResource Switch}" HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource UI095}"/></Grid>
     </StackPanel>
    </Border>
   </StackPanel>
   <Button x:Name="RecordButton" Click="RecordClick" Content="{DynamicResource UI025}" Background="#FF625B" Foreground="White" FontWeight="SemiBold" FontSize="21" Height="62" Margin="0,20,0,0" AutomationProperties.Name="{DynamicResource UI096}"/>
   <Grid Margin="0,10,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="ShortcutText" Text="{DynamicResource UI077}" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    <Button x:Name="EditHotkeyButton" Grid.Column="1" Content="{DynamicResource UI078}" Click="EditHotkeyClick" FontSize="11" Padding="10,7"/>
   </Grid>
   <Border x:Name="HotkeyEditor" Visibility="Collapsed" Background="#222832" CornerRadius="10" Padding="12" Margin="0,10,0,0">
    <StackPanel>
     <TextBlock Text="{DynamicResource UI081}" FontSize="11" Foreground="{StaticResource Muted}"/>
     <Button x:Name="CaptureHotkeyButton" Content="{DynamicResource UI079}" FontSize="16" Margin="0,10,0,8" Padding="10,8" AutomationProperties.Name="{DynamicResource UI097}"/>
     <TextBlock x:Name="HotkeyHint" Text="{DynamicResource UI080}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,10"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="{DynamicResource UI090}" Click="ResetHotkeyClick" FontSize="11" Padding="10,7" Margin="0,0,8,0"/>
      <Button Content="{DynamicResource UI091}" Click="CancelHotkeyClick" FontSize="11" Padding="10,7" Margin="0,0,8,0"/>
      <Button x:Name="SaveHotkeyButton" Content="{DynamicResource UI092}" Click="SaveHotkeyClick" FontSize="11" Padding="14,7" Background="#FF625B" Foreground="White"/>
     </StackPanel>
    </StackPanel>
   </Border>
   <TextBlock x:Name="StatusText" Text="{DynamicResource UI057}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,13,0,0"/>
  </StackPanel></ScrollViewer>
  <Grid Grid.Row="2" Margin="0,16,0,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="FolderButton" Content="{DynamicResource UI059}" Click="OpenFolderClick" HorizontalAlignment="Left" Background="Transparent" Padding="0,8"/>
   <Button x:Name="ChangeFolderButton" Grid.Column="1" Content="{DynamicResource UI060}" Click="ChangeFolderClick" FontSize="11" Padding="10,8"/>
  </Grid>
 </Grid>
</Window>
